# Application
APP_NAME=Review Service
APP_VERSION=1.0.0
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8088

# Database
DATABASE_URL=postgresql+asyncpg://bookstore:dev_password@localhost:5432/reviews_db

# Database Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=True
DB_ECHO=False

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# gRPC (for future use)
GRPC_PORT=50058

# RabbitMQ (for future use)
RABBITMQ_URL=amqp://bookstore:dev_password@rabbitmq:5672/

# Logging
LOG_LEVEL=INFO
