# Application
APP_NAME=Recommendation Service
APP_VERSION=1.0.0
DEBUG=False

# Server
HOST=0.0.0.0
PORT=8089
GRPC_PORT=50059

# Database
DATABASE_URL=postgresql://bookstore:password@localhost:5432/recommendations_db

# External Services (gRPC)
CATALOG_SERVICE_URL=catalog-service:50051
USER_SERVICE_URL=user-service:50052
ORDER_SERVICE_URL=order-service:50054

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Recommendation Settings
DEFAULT_RECOMMENDATIONS_COUNT=10
MIN_INTERACTIONS_FOR_COLLABORATIVE=3
SIMILARITY_THRESHOLD=0.3

# Strategy Weights
TAG_WEIGHT=0.4
COLLABORATIVE_WEIGHT=0.4
POPULAR_WEIGHT=0.2

# CORS
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO

# Observability
JAEGER_AGENT_HOST=jaeger-agent
JAEGER_AGENT_PORT=6831
